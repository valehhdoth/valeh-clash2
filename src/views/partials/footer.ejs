<footer class="mt-auto border-t border-slate-800/50 bg-slate-950/90 backdrop-blur-xl py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">

      <!-- Brand -->
      <div class="space-y-3">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-amber-700 p-px">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
              <span class="text-lg">🏰</span>
            </div>
          </div>
          <span class="heading-font font-bold text-xl text-white">CLASH<span class="text-amber-400">PORTAL</span></span>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed max-w-xs">
          <%= t('footer.description') %>
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3"><%= t('footer.pages') %></h4>
        <div class="grid grid-cols-2 gap-2 text-sm">
          <a href="/" class="text-slate-500 hover:text-amber-400 transition flex items-center gap-1.5"><i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i> <%= t('nav.home') %></a>
          <a href="/rankings" class="text-slate-500 hover:text-amber-400 transition flex items-center gap-1.5"><i data-lucide="trophy" class="w-3.5 h-3.5"></i> <%= t('nav.rankings') %></a>
          <a href="/player" class="text-slate-500 hover:text-amber-400 transition flex items-center gap-1.5"><i data-lucide="user" class="w-3.5 h-3.5"></i> <%= t('nav.player') %></a>
          <a href="/leagues" class="text-slate-500 hover:text-amber-400 transition flex items-center gap-1.5"><i data-lucide="medal" class="w-3.5 h-3.5"></i> <%= t('nav.leagues') %></a>
          <a href="/clan" class="text-slate-500 hover:text-amber-400 transition flex items-center gap-1.5"><i data-lucide="swords" class="w-3.5 h-3.5"></i> <%= t('nav.clan') %></a>
          <a href="/goldpass" class="text-slate-500 hover:text-amber-400 transition flex items-center gap-1.5"><i data-lucide="sparkles" class="w-3.5 h-3.5"></i> <%= t('nav.goldPass') %></a>
        </div>
      </div>

      <!-- Legal & API -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3"><%= t('footer.legal') %></h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          <%= t('footer.disclaimer') %>
          <br>
          <a href="https://supercell.com/en/fan-content-policy/" target="_blank" rel="noopener noreferrer" class="text-amber-500/80 hover:text-amber-400 underline underline-offset-2 mt-1 inline-block"><%= t('footer.policyLink') %></a>
        </p>
        <div class="mt-4 flex items-center gap-3 flex-wrap">
          <a 
            href="https://discord.gg/PpNcckMmv" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3.5 py-1.5 rounded-xl bg-[#5865F2]/20 hover:bg-[#5865F2]/30 text-[#8ea1e1] hover:text-white border border-[#5865F2]/40 text-xs font-bold transition flex items-center gap-2 shadow"
          >
            <svg class="w-4 h-4 fill-current text-[#7289da]" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            <span>Discord Sunucumuza Katıl</span>
          </a>
          <div class="flex items-center gap-1.5 text-xs text-slate-500 font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Supercell Official API v1</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-slate-800/50 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-xs text-slate-600"><%= t('footer.copyright') %></p>
      <p class="text-xs text-slate-700"><%= t('footer.trademark') %></p>
    </div>
  </div>
</footer>

<!-- Scripts -->
<script src="/js/main.js"></script>
<script src="/js/clash-fx.js"></script>
<script>
  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
</body>
</html>
