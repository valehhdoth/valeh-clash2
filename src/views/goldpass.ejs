<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">

  <!-- Header / Season Banner -->
  <div class="glass-card rounded-3xl p-8 sm:p-10 mb-8 border border-amber-500/30 relative overflow-hidden shadow-2xl">
    <div class="absolute -top-24 -right-24 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold mb-3">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span><%= goldPass ? goldPass.season : t('goldpass.tracker') %></span>
        </div>
        <h1 class="heading-font text-3xl sm:text-4xl font-extrabold text-white">
          <%= t('goldpass.title') %>
        </h1>
        <p class="text-sm text-slate-300 mt-2 max-w-xl">
          <%= t('goldpass.description') %>
        </p>
      </div>

      <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800 text-center flex flex-col items-center">
        <div class="text-[11px] text-slate-400 uppercase font-semibold"><%= t('goldpass.seasonEnd') %></div>
        <div class="heading-font text-2xl font-black text-amber-400 mt-1" data-countdown="<%= goldPass ? goldPass.endTime : '' %>">
          9g 14s 22d
        </div>
      </div>
    </div>
  </div>

  <!-- Season Perks -->
  <% if (goldPass && goldPass.perks) { %>
  <div class="mb-10">
    <h2 class="heading-font text-2xl font-bold text-white mb-4 flex items-center gap-2">
      <i data-lucide="zap" class="w-5 h-5 text-amber-400"></i> <%= t('goldpass.perks') %>
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% goldPass.perks.forEach(function(perk) { %>
        <div class="glass-card rounded-2xl p-5 border border-slate-800 flex items-start space-x-3.5">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 flex-shrink-0">
            <i data-lucide="award" class="w-5 h-5"></i>
          </div>
          <div>
            <h4 class="font-bold text-white text-sm"><%= perk.title %></h4>
            <p class="text-xs text-slate-400 mt-1"><%= perk.desc %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- Rewards Road Preview -->
  <% if (goldPass && goldPass.rewards) { %>
  <div class="glass-card rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl">
    <h2 class="heading-font text-2xl font-bold text-white mb-6 flex items-center gap-2">
      <i data-lucide="gift" class="w-5 h-5 text-amber-400"></i> <%= t('goldpass.rewardsRoad') %>
    </h2>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="text-xs text-slate-400 uppercase bg-slate-900/80 border-b border-slate-800">
          <tr>
            <th class="px-4 py-3"><%= t('goldpass.tier') %></th>
            <th class="px-4 py-3"><%= t('goldpass.freeTrack') %></th>
            <th class="px-4 py-3 text-amber-400"><%= t('goldpass.passTrack') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% goldPass.rewards.forEach(function(r) { %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="px-4 py-3 font-mono font-bold text-slate-400 text-xs">
                <%= t('goldpass.tier') %> <%= r.tier %>
              </td>
              <td class="px-4 py-3 text-slate-300 font-medium">
                <%= r.free %>
              </td>
              <td class="px-4 py-3 font-bold text-amber-300">
                <%= r.pass %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

</main>

<%- include('partials/footer') %>
